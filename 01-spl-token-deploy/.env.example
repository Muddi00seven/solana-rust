# Deployer wallet's secret key, base58-encoded (the same format `solana-keygen`
# and Phantom's "Export Private Key" produce as a string). NEVER commit the real
# .env file - it stays out of git because of .gitignore.
#
# How to get this:
#   1. solana-keygen new --outfile ~/deployer-raw.json     (creates a fresh wallet)
#   2. node scripts/keypair-to-base58.js ~/deployer-raw.json
#   3. copy the printed base58 string below
DEPLOYER_PRIVATE_KEY=

# Devnet RPC endpoint. The public one is rate-limited; swap in a free Helius/
# QuickNode devnet URL if you hit 429s during class.
RPC_URL=https://api.devnet.solana.com
