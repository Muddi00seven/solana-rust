# Same convention as project 1 - base58 secret key, generated locally, never
# committed. Used by every scripts/*.ts file in this project.
DEPLOYER_PRIVATE_KEY=

RPC_URL=https://api.devnet.solana.com

# Optional: an existing SPL token mint (e.g. the one you created in
# project 1, or devnet USDC) to run campaigns in. If left blank,
# scripts/create-campaign.ts creates a fresh test mint for you.
TOKEN_MINT=
